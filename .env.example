# ==============================================================================
# CourtIQ - Environment Configuration Template
# Copy this file to .env and customize with your environment values.
# NEVER commit the actual .env file with secrets to Git.
# ==============================================================================

# Application Environment (development, staging, production)
COURTIQ_ENV=development

# Operating Mode: LIVE (real Sportradar API calls) or DEMO (synthetic offline fixtures)
# When set to LIVE, missing or invalid credentials will raise an explicit error.
COURTIQ_MODE=DEMO

# Sportradar Tennis API Configuration
# Get your API key at: https://console.sportradar.com/signup
SPORTRADAR_API_KEY=your_sportradar_api_key_here
SPORTRADAR_BASE_URL=https://api.sportradar.com/tennis/trial/v3/en
SPORTRADAR_FORMAT=json
SPORTRADAR_TIMEOUT=15
SPORTRADAR_RATE_LIMIT_RPS=1.0
SPORTRADAR_MAX_RETRIES=3
SPORTRADAR_BACKOFF_FACTOR=1.5

# ==============================================================================
# PostgreSQL Database Configuration (Primary Shared Relational Store)
# Driver: Psycopg 3 (postgresql+psycopg://user:password@127.0.0.1:5432/dbname)
# Note: Standardized on 127.0.0.1 to avoid Windows IPv6 (::1) socket resolution delays.
# ==============================================================================

# 1. Mandatory Passwords (Required for Docker Compose and database initialization)
POSTGRES_SUPERUSER_PASSWORD=your_secure_postgres_superuser_password_here
COURTIQ_MIGRATOR_PASSWORD=your_secure_migrator_password_here
COURTIQ_APP_PASSWORD=your_secure_app_password_here

# 2. Application Runtime Connection (DML Only: SELECT, INSERT, UPDATE, DELETE)
# Identifies the least-privilege role used by Streamlit application & ordinary runtime queries
DATABASE_URL=postgresql+psycopg://courtiq_app:your_secure_app_password_here@127.0.0.1:5432/courtiq

# 3. Database Migration Connection (DDL & Schema Management: CREATE, ALTER, DROP)
# Dedicated role used exclusively by Alembic migrations & schema evolution
MIGRATION_DATABASE_URL=postgresql+psycopg://courtiq_migrator:your_secure_migrator_password_here@127.0.0.1:5432/courtiq

# 4. Disposable Automated Test Database URL (Used by Pytest)
# Tests execute against an isolated test database (courtiq_test), never the main database
TEST_DATABASE_URL=postgresql+psycopg://courtiq_migrator:your_secure_migrator_password_here@127.0.0.1:5432/courtiq_test

# Database Connection Pool Settings (SQLAlchemy QueuePool)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Legacy SQLite Database Path (Used only by SQLite-to-PostgreSQL migration utility)
COURTIQ_DB_PATH=data/courtiq.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
