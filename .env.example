# ==============================================================================
# CourtIQ - Environment Configuration Template
# Copy this file to .env and populate with your credentials.
# NEVER commit the actual .env file with secrets to Git.
# ==============================================================================

# Application Environment (development, staging, production)
COURTIQ_ENV=development

# Sportradar Tennis API Configuration
# Get your API key at: https://console.sportradar.com/signup
SPORTRADAR_API_KEY=your_sportradar_api_key_here
SPORTRADAR_BASE_URL=https://api.sportradar.com/tennis/trial/v3/en
SPORTRADAR_FORMAT=json
SPORTRADAR_TIMEOUT=15
SPORTRADAR_RATE_LIMIT_RPS=1.0
SPORTRADAR_MAX_RETRIES=3
SPORTRADAR_BACKOFF_FACTOR=1.5

# Database Configuration
# Default is zero-dependency SQLite database in local data directory
COURTIQ_DB_PATH=data/courtiq.db

# Optional: SQLAlchemy Database URI (supports sqlite, postgresql, mysql)
# Example PostgreSQL: postgresql://user:password@localhost:5432/courtiq
# Example MySQL: mysql+pymysql://user:password@localhost:3306/courtiq
DATABASE_URL=sqlite:///data/courtiq.db

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json
